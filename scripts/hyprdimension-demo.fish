#!/usr/bin/env fish
set -l plugin "$PWD/build/hyprdimension/hyprdimension.so"; set -l monitor (hyprctl monitors -j | jq -r '.[0].name'); set -l client (hyprctl clients -j | jq -c --arg monitor "$monitor" 'map(select(.monitor == $monitor))[0]'); set -l address (string match -r '"address":\s*"([^"]+)' -- "$client")[2]; set -l workspace (string match -r '"workspace":\s*\{"id":\s*(-?[0-9]+)' -- "$client")[2]; test -n "$monitor"; and test -n "$address"; and test -n "$workspace"; or begin; echo "No Hyprland client found"; exit 1; end; just build; hyprctl plugin unload "$plugin" 2>/dev/null; or true; hyprctl plugin load "$plugin"; sleep 1; hyprctl dispatch "function() hl.plugin.hyprdimension.assign(\"$monitor $workspace\") end"; sleep 1; hyprctl dispatch "function() hl.plugin.hyprdimension.configure(\"$monitor 2 4 16 32\") end"; sleep 1; hyprctl dispatch "function() hl.plugin.hyprdimension.open(\"$monitor $address\") end"; sleep 1; hyprctl dispatch "function() hl.plugin.hyprdimension.place(\"$monitor $address 0 0 1 1\") end"; sleep 1; hyprctl dispatch "function() hl.plugin.hyprdimension.zoom(\"$monitor 0.8\") end"; sleep 2; hyprctl dispatch "function() hl.plugin.hyprdimension.zoom(\"$monitor 0.65\") end"; sleep 1; hyprctl dispatch "function() hl.plugin.hyprdimension.camera(\"$monitor 400 200\") end"; sleep 2; hyprctl dispatch "function() hl.plugin.hyprdimension.camera(\"$monitor -300 -150\") end"; sleep 2; hyprctl dispatch "function() hl.plugin.hyprdimension.floating(\"$monitor $address\") end"; sleep 2; hyprctl dispatch "function() hl.plugin.hyprdimension.floating(\"$monitor $address\") end"; sleep 1; hyprctl dispatch "function() hl.plugin.hyprdimension.zoom(\"$monitor 1.0\") end"; sleep 2; hyprctl dispatch "function() hl.plugin.hyprdimension.focus(\"$monitor $address\") end"; sleep 2; hyprctl plugin list; hyprctl plugin unload "$plugin"
